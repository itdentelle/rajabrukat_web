model Collection {
  id          String   @id @default(uuid())
  title       String
  subtitle    String?
  description String?
  imageUrl    String?
  color       String   @default("bg-zinc-900")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FaqItem {
  id        String   @id @default(uuid())
  category  String   @default("Pemesanan & Ukuran")
  question  String
  answer    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String   @db.Text
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VisitorLog {
  id        String   @id @default(uuid())
  ip        String?
  path      String
  userAgent String?
  device    String?  @default("Desktop")
  city      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}



