# ========================================================
# RAJA BRUKAT - BACKEND ENVIRONMENT VARIABLES (.env)
# ========================================================

# --- DATABASE (Pilih salah satu) ---
# Opsi B: PostgreSQL Lokal di VPS (Rekomendasi untuk self-hosted)
DATABASE_URL="postgresql://postgres:password_db_vps@localhost:5432/rajabrukat"
DIRECT_URL="postgresql://postgres:password_db_vps@localhost:5432/rajabrukat"

# Server Port
PORT=5001

# Frontend URL (untuk CORS & Redirect Midtrans)
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000,https://rajabrukat.com"

# --- AUTH & SECURITY ---
ADMIN_EMAIL=admin@rajabrukat.com
ADMIN_PASSWORD=GantiDenganPasswordAman123!
JWT_SECRET=buat-string-acak-rahasia-dan-panjang-disini-minimal-32-karakter

# --- PAYMENT (MIDTRANS) ---
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""

# --- EXPEDITION & SHIPPING ---
RAJAONGKIR_API_KEY=""
BITESHIP_API_KEY=""

# --- EMAIL (SMTP) ---
EMAIL_USER=noreply@rajabrukat.com
EMAIL_PASS=app-password-email-anda

# --- CACHE & QUEUE (Opsional, kosongkan jika belum pakai Redis) ---
REDIS_URL=""

# --- AI ASSISTANT ---
GEMINI_API_KEY=""

# --- STORAGE (Opsional jika ingin tetap simpan gambar di Supabase CDN) ---
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="products"
